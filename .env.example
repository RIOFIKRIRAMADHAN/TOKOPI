# Salin ke .env lalu sesuaikan:  cp .env.example .env
APP_NAME=Tokopi
APP_URL=http://localhost/tokopi
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tokoku
DB_USER=root
DB_PASS=

# Midtrans (Sandbox). Ambil key di dashboard.sandbox.midtrans.com > Settings > Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
